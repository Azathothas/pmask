#compdef pmask
# zsh completion for pmask.  Static file for the hand-written parser.

_pmask() {
    _arguments -s \
        '--profile[select execution and stealth profile]:profile:(auto single tree tee compat)' \
        '--auto[alias for --profile auto (the default)]' \
        '--follow[follow and redact all descendants (tree mode)]' \
        '--no-rexec[opt out of profile-default --rexec image staging]' \
        '--rexec-mode[image carrier for --rexec]:mode:(auto path tmpfile memfd)' \
        '--cwd[change child working directory after resolving COMMAND]:dir:_directories' \
        '--parent-label[separate presentation label for tree-mode supervisor]:label:' \
        '--reparent[double-fork masked payload to PID 1 in single profile]' \
        '--allow-impersonation[allow kernel-thread or critical-service labels]' \
        '--secret-fd[keep caller fd open across exec and export PMASK_SECRET_*]:spec:' \
        '--explain[print observer, capabilities, tradeoffs, and residuals]' \
        '--profile-json[emit native psgen schema: 2 profile JSON]' \
        '--pid[target PID for standalone --audit or --profile-json]:pid:' \
        '--observer[observer perspective for --audit]:role:(same-uid other-uid)' \
        '--json[emit JSON output for --audit, --explain, or --profile-json]' \
        '--token-env[env var holding secret token to hunt during --audit]:var:' \
        '--token-fd[file descriptor holding secret token to hunt during --audit]:fd:' \
        '--real-exe[expected real executable path to verify hidden in --audit]:path:_files' \
        '--real-cwd[expected real working directory to verify hidden in --audit]:dir:_directories' \
        '--allow-memfd[permit /memfd: exe paths in single-profile --audit]' \
        '(-l --label)'{-l,--label}'[presentation label]:label:' \
        '--label-empty[empty label]' \
        '--argv0[argv[0] of the program]:name:' \
        '--comm[process name for top]:name:' \
        '--keep-env[leave environ visible]' \
        '--keep-env=-[keep only named variables visible]:names:' \
        '--env[add or replace one variable]:assignment:' \
        '--env-file[read variables from a file]:file:_files' \
        '--args-from-fd[read the command from a descriptor]:fd:' \
        '--on-exit[what happens to descendants]:policy:(detach wait kill)' \
        '--no-follow[redact only the direct child]' \
        '--no-exit-kill[do not set PTRACE_O_EXITKILL]' \
        '--no-exitkill[alias for --no-exit-kill]' \
        '--no-dumpable[set PR_SET_DUMPABLE=0]' \
        '--allow-dumpable[keep the payload dumpable]' \
        '--strict-exec[refuse exec shapes that cannot be redacted at entry]' \
        '--allow-foreign[run a 32-bit image unredacted]' \
        '--hide-pid[hide the tree from same-uid /proc readers]' \
        '--encrypt-memory[seal at-rest copies (memfd_secret key) and mark block MADV_DONTDUMP]' \
        '--stealth[compose --rexec, --watch-rename and the best dumpable choice]' \
        '--no-new-privs[set no_new_privs]' \
        '--no-exact[keep the original cmdline byte extent]' \
        '--detach[detach each tracee after its exec; TracerPid reads 0]' \
        '--watch-rename[revert later renames to the label]' \
        '--watch-rename=-[revert later renames with strict write traps]:mode:(strict)' \
        '--rexec[exec from a staged image or sealed memfd]' \
        '--image[read the program bytes from PATH; - reads stdin]:path:_files' \
        '--image-from-fd[read the program bytes from a descriptor]:fd:' \
        '--exec-once[reuse one sealed image per distinct program]' \
        '--hugetlb[ask for a hugetlbfs-backed image]' \
        '--rexec-allow-disk[allow the on-disk last resort of --rexec]' \
        '--unshare[new user, pid and mount namespaces]' \
        '--scope-name[systemd transient scope name]:name:' \
        '--daemon[run the job in a pmaskd]:socket:_files' \
        '--secret[deliver a secret on a descriptor: N=SRC]:spec:' \
        '--socket[secret-agent socket for agent: sources]:path:_files' \
        '--isolate[fresh namespaces]:list:(pid,net,tmp all none)' \
        '--redact[ask for /proc redaction explicitly]' \
        '--no-redact[never touch /proc metadata]' \
        '--audit[run standalone self/PID /proc audit or per-exec residue rows]' \
        '--allow-argv-secret[keep a literal: or env: source and warn]' \
        '--secret-burn[seal without F_SEAL_SHRINK so the reader can truncate]' \
        '--secret-close-on-exec[close the descriptor in every descendant at its fork]' \
        '--report[output format]:format:(json)' \
        '--report-file[write the --report document to PATH]:path:_files' \
        '--report-fd[write the --report document to a descriptor]:fd:' \
        '--secret-fd-name[name the delivered secret memfd]:name:' \
        '--memfd-name[name the image memfd]:name:' \
        '(-q --quiet)'{-q,--quiet}'[suppress diagnostics]' \
        '(-v --verbose)'{-v,--verbose}'[trace every event]' \
        '(-V --version)'{-V,--version}'[print version]' \
        '(-h --help)'{-h,--help}'[print help (--help=all for full reference)]' \
        '--help-all[print complete flag reference]' \
        '(-l --label)'{-a}'[alias for --label]:label:' \
        '(-E)'-E'[alias for --keep-env]' \
        '(-F)'-F'[alias for --no-follow]' \
        '(-K)'-K'[alias for --no-exit-kill]' \
        '(-f)'-f'[accepted for compatibility, no effect]' \
        '(-c)'-c'[accepted for compatibility, no effect]' \
        '1:subcommand or command:_pmask_subcmd' \
        '*::command:_normal'
}

_pmask_subcmd() {
    local -a subcmds
    subcmds=(
        'run:run a command (same parser as the default mode)'
        'store:manage the encrypted secret store'
        'agent:hold the store unlocked and serve it'
        'get:ask a running agent for one secret'
        'read:print a secret delivered to this process'
        'probe:report what this host allows'
        'doctor:report store, agent and guarantee verdict'
        'help:print help'
        'version:print version'
    )
    _describe -t subcommands 'pmask subcommand' subcmds
    _command_names -e
}

_pmask "$@"
